{
  "artifactsDir": ".e2e-artifacts",
  "credentials": {
    "admin": {
      "email": "$ENV:E2E_ADMIN_EMAIL",
      "password": "$ENV:E2E_ADMIN_PASS"
    },
    "driver": {
      "email": "$ENV:E2E_DRIVER_EMAIL",
      "password": "$ENV:E2E_DRIVER_PASS"
    }
  },
  "services": {
    "api": {
      "cwd": "backend",
      "command": "uvicorn app.main:app --port ${PORT}",
      "port": 8000,
      "health": "/health",
      "startupTimeoutSec": 120
    },
    "web": {
      "cwd": "frontend",
      "command": "pnpm exec next dev --port ${PORT}",
      "port": 3000,
      "health": "/",
      "env": {
        "NEXT_PUBLIC_API_BASE_URL": "${api.url}"
      }
    }
  },
  "browser": {
    "baseUrl": "${web.url}",
    "viewport": [
      1440,
      900
    ],
    "auth": {
      "path": "/login",
      "fields": {
        "#email": "{{email|username}}",
        "#password": "{{password}}"
      },
      "submit": "button[type=submit]",
      "defaultUser": "admin"
    }
  },
  "mobile": {
    "platform": "android",
    "android": {
      "package": "com.example.app",
      "reversePorts": true
    }
  }
}
