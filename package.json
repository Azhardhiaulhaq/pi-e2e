{
  "name": "pi-e2e",
  "version": "0.3.0",
  "type": "module",
  "description": "Pi package: start your local services, drive a headless browser or a mobile app, and verify features end to end.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "e2e",
    "playwright",
    "testing",
    "android"
  ],
  "license": "MIT",
  "author": "Azhar Dhiaulhaq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azhardhiaulhaq/pi-e2e.git"
  },
  "homepage": "https://github.com/Azhardhiaulhaq/pi-e2e#readme",
  "files": [
    "extensions",
    "lib",
    "skills",
    "scripts",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "npm install",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/e2e.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
